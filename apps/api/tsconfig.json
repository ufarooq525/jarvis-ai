{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": "../..",
    "paths": {
      "@jarvis/core/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../src/**/*.ts"]
}
